[Desktop Entry]
Type=Application
Name=Craft Anything
Name[ru]=Craft Anything
GenericName=Software Explorer
GenericName[ru]=Исследование программ
Comment=Find out how any software works, then craft your own
Comment[ru]=Узнайте, как устроена любая программа, а затем создайте свою
Exec=craft-anything %F
TryExec=craft-anything
Icon=ai.storyteller.craft-anything
Terminal=false
StartupNotify=true
StartupWMClass=ai.storyteller.craft-anything
Categories=Development;Debugger;
Keywords=reverse engineering;disassembler;binary;analysis;executable;decompiler;inspect;
Keywords[ru]=обратная разработка;реверс-инжиниринг;дизассемблер;двоичный файл;анализ;исполняемый файл;декомпилятор;исследование;
