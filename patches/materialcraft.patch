+
+    #[test]
+    fn russian_table_has_no_duplicate_keys() {
+        let mut seen = std::collections::HashSet::new();
+        for (k, _) in ru::TABLE {
+            assert!(seen.insert(*k), "duplicate key in ru::TABLE: {k:?}");
+        }
+    }
+
+    #[test]
+    fn placeholders_match_between_key_and_russian_translation() {
+        for (k, v) in ru::TABLE {
+            let mut kp: Vec<&str> = k.split('{').skip(1).filter_map(|s| s.split_once('}').map(|(p, _)| p)).collect();
+            let mut vp: Vec<&str> = v.split('{').skip(1).filter_map(|s| s.split_once('}').map(|(p, _)| p)).collect();
+            kp.sort();
+            vp.sort();
+            assert_eq!(kp, vp, "mismatched placeholders in {k:?} vs {v:?}");
+        }
+    }
+
+    #[test]
+    fn russian_table_covers_every_arabic_key() {
+        let ar: std::collections::HashSet<&str> = ar::TABLE.iter().map(|(k, _)| *k).collect();
+        let ru: std::collections::HashSet<&str> = ru::TABLE.iter().map(|(k, _)| *k).collect();
+        let missing: Vec<&str> = ar.difference(&ru).copied().collect();
+        assert!(missing.is_empty(), "ru::TABLE missing keys present in ar::TABLE: {missing:?}");
+    }
 }

